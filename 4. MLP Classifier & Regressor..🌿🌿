#########################################

import numpy as np
from sklearn.neural_network import MLPRegressor

# 1. Create a small dataset
# Features: [hours studied, practice problems solved]
X = np.array([
    [1, 10],
    [2, 20],
    [3, 30],
    [4, 40]
])

# Target: final score
y = np.array([40, 50, 60, 70])

print("Training Data (X):")
print(X)
print("\nTarget Values (y):")
print(y)

# 2. Build the MLP Regressor
model = MLPRegressor(
    hidden_layer_sizes=(4,),   # one hidden layer with 4 neurons
    activation='relu',
    solver='adam',
    max_iter=100
)

# 3. Train the model
model.fit(X, y)

print("\nModel training complete!")

# 4. Make a prediction
new_student = np.array([[5, 50]])
prediction = model.predict(new_student)

print("\nNew Input:", new_student)
print("Predicted Score:", round(prediction[0], 2))

